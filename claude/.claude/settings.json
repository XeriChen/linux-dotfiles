{
  "cleanupPeriodDays": 3650,
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "1",
    "CLAUDE_CODE_BASH_SANDBOX_SHOW_INDICATOR": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "BASH_MAX_OUTPUT_LENGTH": "10000",
    "BASH_MAX_TIMEOUT_MS": "240000",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-head-read.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-head-tail-pipe.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-bg-head-tail-pipe.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-heredoc.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-cat-write.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-background-ampersand.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-sed-print.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-git-amend.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-destructive-git.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-devnull-redirect.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-dangerous-ops.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-pip-npm.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-worktree-team.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/python-unbuffered.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "TaskOutput",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/task-output-timeout-cap.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-schedule-wakeup-deadzone.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/no-multi-question.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/reread-after-edit.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/hint-agent-claude-code-guide.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/prefer-uv-run.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/python-unbuffered-post.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/warn-auto-bg-head-tail-pipe.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/cache-keepalive-hint.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/verify-explore-results.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/pep723-script.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/hint-fork-on-bloat.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/websearch-followup-hint.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "SendUserFile",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/track-sent-file.sh", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/inject-git-status.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/inject-system-load.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/inject-time.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/block-note-prompt.sh", "timeout": 5 }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/compact-bump.sh", "timeout": 5 }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "viewMode": "default",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoScrollEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
